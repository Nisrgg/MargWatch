# MargWatch Mobile App Configuration
# Copy this file to local.properties and fill in your actual values

# Backend API URL (Replace with your computer's IP address)
BACKEND_URL=http://YOUR_COMPUTER_IP:5000

# Google Maps API Key (Get from Google Cloud Console)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Android SDK Location (Auto-detected by Android Studio)
sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk
