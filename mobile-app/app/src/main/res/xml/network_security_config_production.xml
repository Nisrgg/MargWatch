<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production config - only allow HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.margwatch.com</domain>
        <domain includeSubdomains="true">margwatch.com</domain>
    </domain-config>
    
    <!-- Development config - allow HTTP for local development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.137.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>


