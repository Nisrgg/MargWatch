# Environment Variables

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/road_issue_portal?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Multi-Image Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Server
PORT=5000
NODE_ENV="development"

# File Upload
MAX_FILE_SIZE=10485760

# ML Model API (if using external service)
ML_MODEL_URL="http://localhost:8000/predict"

# Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Frontend URLs
FRONTEND_URL="http://localhost:3000"
MOBILE_URL="http://localhost:3001"

# Firebase Configuration
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# Default Passwords for Seeding (Change these!)
ADMIN_PASSWORD="admin123"
WORKER_PASSWORD="worker123"
USER_PASSWORD="user123"